---
import Base from '../../layouts/Base.astro';
import fighters from '../../data/fighters.json';
import articles from '../../data/articles.json';
import { formatDate, publishedArticles } from '../../lib/editorial.mjs';

export function getStaticPaths() {
  return fighters.map(fighter => ({ params: { slug: fighter.slug }, props: { fighter } }));
}

const { fighter } = Astro.props;
const relatedArticles = publishedArticles(articles).filter(article =>
  article.title.toLowerCase().includes(fighter.name.toLowerCase()) ||
  article.excerpt.toLowerCase().includes(fighter.name.toLowerCase())
).slice(0, 3);
const description = fighter.name + ' : ' + fighter.division + ', ' + fighter.org + '. ' + (fighter.record ? 'Bilan ' + fighter.record + ', parcours et résultats sourcés.' : 'Parcours et sources de la fiche.') + ' Vérifié le ' + formatDate(fighter.verifiedAt) + '.';
---

<Base
  title={fighter.name + ' — Parcours et bilan MMA'}
  description={description}
  image={fighter.image}
  currentNav="combattants"
>
  <div class="wrap fighter-page">
    <nav class="breadcrumbs mono" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a> <span>/</span>
      <a href="/combattants/">Combattants</a> <span>/</span>
      <span class="active">{fighter.name}</span>
    </nav>

    <div class="fighter-hero-grid" data-reveal>
      <figure class="fighter-portrait">
        <div class="fighter-portrait-stage">
          <img src={fighter.image} alt={fighter.imageAlt} width="640" height="640" fetchpriority="high" />
          <div class="portrait-glow"></div>
        </div>
        <figcaption class="fighter-image-note mono">{fighter.imageCaption} <a href={fighter.imageSource.pageUrl} target="_blank" rel="noopener noreferrer">Voir la source ↗</a></figcaption>
      </figure>

      <div class="fighter-header-info">
        <div class="fighter-badge-row">
          <span class="org-badge mono">{fighter.org}</span>
          <span class="country-badge mono">{fighter.flag} {fighter.country}</span>
          {fighter.title && <span class="champion-badge mono">🏆 {fighter.title}</span>}
        </div>

        {fighter.nickname && <span class="fighter-nickname display">« {fighter.nickname} »</span>}
        <h1 class="display fighter-main-name">{fighter.name}</h1>
        <p class="fighter-division mono">{fighter.division}</p>

        {fighter.record && (
          <>
            <div class="fighter-record-bar">
              <div class="record-stat">
                <span class="stat-num display">{fighter.record}</span>
                <span class="stat-lbl mono">Victoires · défaites · nuls</span>
              </div>
              <div class="record-breakdown mono">
                {fighter.koWins != null && <span class="chip ko">{fighter.koWins} KO/TKO</span>}
                {fighter.subWins != null && <span class="chip sub">{fighter.subWins} Soumissions</span>}
                {fighter.decWins != null && <span class="chip dec">{fighter.decWins} Décisions</span>}
              </div>
            </div>
            <p class="fighter-record-note">{fighter.recordScope}.{fighter.recordNote ? ' ' + fighter.recordNote : ''}</p>
          </>
        )}

        <div class="tale-of-tape mono">
          {fighter.gym && (
            <div class="tape-row">
              <span class="t-lbl">Club d'entraînement</span>
              <span class="t-val">{fighter.gym}{fighter.city ? ' · ' + fighter.city : ''}</span>
            </div>
          )}
          {fighter.height && (
            <div class="tape-row"><span class="t-lbl">Taille</span><span class="t-val">{fighter.height}</span></div>
          )}
          {fighter.reach && (
            <div class="tape-row"><span class="t-lbl">Allonge</span><span class="t-val">{fighter.reach}</span></div>
          )}
        </div>
        <p class="fighter-verified mono">Fiche vérifiée le <time datetime={fighter.verifiedAt}>{formatDate(fighter.verifiedAt)}</time>.</p>
      </div>
    </div>

    {fighter.fightsHistory?.length > 0 && (
      <section class="fighter-history-section" data-reveal>
        <span class="kicker">Résultats sourcés</span>
        <h2 class="display">Sélection de combats</h2>
        <div class="fights-table-wrap">
          <table class="fights-table mono">
            <caption>Résultats vérifiés dans les sources ci-dessous. Cette sélection ne constitue pas l'ensemble du palmarès.</caption>
            <thead>
              <tr><th>Résultat</th><th>Adversaire</th><th>Événement & date</th><th>Méthode</th><th>Round & temps</th></tr>
            </thead>
            <tbody>
              {fighter.fightsHistory.map(fight => (
                <tr class={fight.res === 'V' ? 'win-row' : fight.res === 'D' ? 'loss-row' : 'neutral-row'}>
                  <td>
                    <span class={'res-badge ' + (fight.res === 'V' ? 'win' : fight.res === 'D' ? 'loss' : 'neutral')}>
                      {fight.res === 'V' ? 'VICTOIRE' : fight.res === 'D' ? 'DÉFAITE' : fight.res === 'NC' ? 'NO CONTEST' : 'NUL'}
                    </span>
                  </td>
                  <td class="adv-name"><strong>{fight.adv}</strong></td>
                  <td>{fight.event}<time datetime={fight.date} class="fight-date">{formatDate(fight.date)}</time></td>
                  <td>{fight.method}</td>
                  <td class="round-time">{fight.round}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section class="fighter-bio-section" data-reveal>
      <span class="kicker">Parcours</span>
      <h2 class="display">Dans la cage</h2>
      <div class="bio-text"><p class="lead">{fighter.bio}</p></div>

      <div class="fighter-source-box">
        <h3 class="display">Sources de la fiche</h3>
        <ul>
          {fighter.sources.map(source => (
            <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.name} · {source.title} ↗</a></li>
          ))}
        </ul>
        <p>Consultées le {formatDate(fighter.verifiedAt)}. Les bilans et les équipes d'entraînement correspondent à cette vérification.</p>
      </div>

      <div class="gym-cross-link">
        <span class="kicker" style="color: var(--teal);">Entraînement MMA</span>
        <p>La lutte, le travail contre la cage et le grappling font partie des bases du MMA. Retrouvez les informations sur les cours au <strong>Boxing Center Toulouse</strong>.</p>
        <a href="https://clubmma.fr/" target="_blank" rel="noopener noreferrer" class="link-teal mono">Découvrir les cours de MMA ↗</a>
      </div>
    </section>

    {relatedArticles.length > 0 && (
      <section class="fighter-articles-section" data-reveal>
        <span class="kicker">Dernières actualités</span>
        <h2 class="display">{fighter.name} dans l'actualité</h2>
        <div class="related-grid">
          {relatedArticles.map(article => (
            <a href={'/actualites/' + article.slug + '/'} class="related-card">
              <div class="related-media"><img src={article.image} alt={article.imageAlt} width="480" height="270" loading="lazy" decoding="async" /></div>
              <div class="related-copy">
                <span class="kicker">{article.kicker}</span>
                <h3 class="display">{article.title}</h3>
                <p>{article.excerpt}</p>
                <time datetime={article.sourcePublishedAt} class="mono">{formatDate(article.sourcePublishedAt)}</time>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  .fighter-portrait { margin: 0; }
  .fighter-image-note, .fighter-verified { margin: 0.85rem 0 0; color: var(--ash); font-size: 0.7rem; line-height: 1.5; }
  .fighter-record-note { margin: 0.8rem 0 1.5rem; color: var(--ash); font-size: 0.85rem; line-height: 1.6; }
  .fighter-record-bar { flex-wrap: wrap; }
  .record-breakdown { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .fight-date { display: block; margin-top: 0.35rem; font-size: 0.7rem; color: var(--ash); }
  .fights-table caption { text-align: left; font-size: 0.75rem; line-height: 1.6; color: var(--ash); padding: 0 0 1rem; }
  .res-badge.neutral { color: var(--ash); background: var(--mist); }
  .fighter-source-box { margin-top: 2rem; padding: 1.5rem; border: 1px solid var(--mist); background: white; }
  .fighter-source-box h3 { margin: 0 0 1rem; font-size: 1.4rem; }
  .fighter-source-box ul { padding-left: 1.15rem; margin: 0 0 1rem; }
  .fighter-source-box li { margin: 0.6rem 0; line-height: 1.6; }
  .fighter-source-box a { color: var(--teal); overflow-wrap: anywhere; }
  .fighter-source-box p { margin: 0; font-size: 0.8rem; line-height: 1.6; color: var(--ash); }
</style>
