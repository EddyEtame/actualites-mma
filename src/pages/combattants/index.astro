---
import Base from '../../layouts/Base.astro';
import fighters from '../../data/fighters.json';
import { formatDate } from '../../lib/editorial.mjs';
---

<Base
  title="Combattants MMA — Fiches, bilans et parcours"
  description="Ciryl Gane, Benoît Saint Denis, Manon Fiorot et les autres combattants suivis par Actu MMA : bilans datés, parcours et liens vers les sources officielles."
  currentNav="combattants"
>
  <div class="wrap archive-page">
    <header class="archive-header" data-reveal>
      <span class="kicker">France & international</span>
      <h1 class="display">Les combattants</h1>
      <p class="lede">Des poids lourds aux poids mouches, retrouvez les parcours des athlètes suivis par Actu MMA. Chaque fiche indique ses sources et la date de vérification de son bilan.</p>
    </header>

    <div class="fighters-full-grid" data-reveal-group>
      {fighters.map(f => (
        <a href={'/combattants/' + f.slug + '/'} class="fighter-roster-card" data-reveal>
          <div class="fighter-card-media">
            <img src={f.image} alt={f.imageAlt} width="480" height="480" loading="lazy" decoding="async" />
            <div class="card-overlay"></div>
            {f.title && <span class="card-title-badge mono">🏆 {f.title}</span>}
          </div>
          <div class="fighter-card-content">
            <p class="fighter-image-note mono">{f.imageCaption}</p>
            <div class="card-top-meta mono">
              <span class="f-org">{f.org} · {f.country}</span>
              {f.record && <span class="f-record">{f.record}</span>}
            </div>
            {f.nickname && <span class="f-nickname display">« {f.nickname} »</span>}
            <h2 class="display f-name">{f.name}</h2>
            <p class="f-division mono">{f.division}</p>
            {f.gym && <span class="f-gym mono">{f.gym}{f.city ? ' · ' + f.city : ''}</span>}
            <p class="fighter-verified mono">Vérifié le {formatDate(f.verifiedAt)}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  .fighter-image-note { margin: 0 0 0.8rem; color: var(--ash); font-size: 0.65rem; line-height: 1.5; }
  .fighter-verified { margin: 1rem 0 0; color: var(--ash); font-size: 0.68rem; line-height: 1.5; }
  .card-top-meta { flex-wrap: wrap; gap: 0.5rem; }
  .card-title-badge { max-width: calc(100% - 24px); line-height: 1.4; }
</style>
