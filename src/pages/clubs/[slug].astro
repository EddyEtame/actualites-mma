---
import Base from '../../layouts/Base.astro';
import clubs from '../../data/clubs.json';

export function getStaticPaths() {
  return clubs.map(club => ({ params: { slug: club.slug }, props: { club } }));
}

const { club } = Astro.props;
const otherClubs = clubs.filter(c => c.slug !== club.slug).slice(0, 3);
const isBoxingCenter = club.slug === 'boxing-center-etats-unis';
const siteUrl = 'https://actu-mma.com';
const verifiedDate = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${club.verifiedAt}T12:00:00Z`));
const specs = [
  club.surface && { label: 'Salle', value: club.surface, detail: 'Superficie annoncée par le club' },
  club.cage && { label: 'MMA', value: club.cage, detail: 'Espace de travail contre la cage' },
  club.tatami && { label: 'Sol', value: club.tatami, detail: 'Surface de tatamis annoncée' }
].filter(Boolean);
const faqItems = [
  { q: `Où se situe ${club.name} ?`, a: `${club.name} se situe au ${club.address}.${club.metro ? ` Accès : ${club.metro}.` : ''}` },
  { q: `Quelles disciplines peut-on pratiquer à ${club.name} ?`, a: `Le site du club présente les disciplines suivantes : ${club.disciplines.join(', ')}.` },
  ...(isBoxingCenter ? [
    { q: 'Qui encadre le grappling et le jiu-jitsu brésilien ?', a: 'Zouhir Boumenir enseigne le grappling et le jiu-jitsu brésilien au Boxing Center États-Unis. Le site du club le présente comme ceinture noire de JJB.' },
    { q: 'Peut-on débuter le MMA dans cette salle ?', a: 'Le club annonce des cours Asso MMA pour débutants et confirmés, ainsi que du MMA jeunes 10–16 ans. Contactez le club pour choisir le créneau de votre premier cours.' }
  ] : []),
  { q: `Où consulter les horaires de ${club.name} ?`, a: club.scheduleNote }
];
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SportsActivityLocation',
  '@id': `${siteUrl}/clubs/${club.slug}/#club`,
  name: club.name,
  description: club.description,
  url: club.website,
  telephone: club.phone || undefined,
  image: club.image ? `${siteUrl}${club.image}` : undefined,
  address: {
    '@type': 'PostalAddress',
    streetAddress: club.streetAddress,
    addressLocality: club.city,
    postalCode: club.postalCode,
    addressRegion: club.region,
    addressCountry: 'FR'
  },
  amenityFeature: specs.map(spec => ({ '@type': 'LocationFeatureSpecification', name: spec.label, value: spec.value }))
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } }))
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Clubs de MMA', item: `${siteUrl}/clubs/` },
    { '@type': 'ListItem', position: 3, name: club.name, item: `${siteUrl}/clubs/${club.slug}/` }
  ]
};
---

<Base title={`${club.name} — MMA à ${club.city}`} description={club.description} image={club.image || undefined} currentNav="clubs">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <header class="club-page-hero">
    <div class="wrap club-hero-content" data-reveal>
      <nav class="breadcrumbs mono" aria-label="Fil d'Ariane"><a href="/">Accueil</a><span aria-hidden="true">/</span><a href="/clubs/">Clubs de MMA</a><span aria-hidden="true">/</span><span class="active" aria-current="page">{club.name}</span></nav>
      <div class="club-header-badge mono"><span>{club.city} · {club.region}</span><span>Fiche club</span></div>
      <h1 class="display club-page-title">{club.name}</h1>
      <p class="club-lead-desc">{club.description}</p>
      <p class="club-address-bar mono">{club.address}{club.metro && <span> · {club.metro}</span>}</p>
      <div class="club-cta-row"><a href={club.scheduleUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary">Consulter le planning du club ↗</a><a href="#informations" class="btn btn--ghost">Disciplines et informations ↓</a></div>
    </div>
  </header>

  <div class="wrap club-main-layout">
    <div class="club-content-col">
      {specs.length > 0 && <section class="club-specs-section" aria-labelledby="equipment-title" data-reveal><span class="kicker">Les installations</span><h2 class="display" id="equipment-title">Des repères pour s'entraîner</h2><div class="specs-grid-cards mono">{specs.map(spec => <div class="spec-card"><span class="spec-label">{spec.label}</span><strong class="spec-value">{spec.value}</strong><span class="spec-sub">{spec.detail}</span></div>)}</div></section>}

      <section class="club-about-section" id="informations" aria-labelledby="practice-title" data-reveal>
        <span class="kicker">La pratique dans cette salle</span><h2 class="display" id="practice-title">MMA et disciplines complémentaires</h2>
        <div class="club-text-body"><p>{club.longDescription}</p><p>{club.practicalNote}</p></div>
        <div class="disciplines-pills mono">{club.disciplines.map(d => <span class="pill">{d}</span>)}</div>
      </section>

      {club.coaches.length > 0 && <section class="club-coaches-section" aria-labelledby="coach-title" data-reveal>
        <span class="kicker">L'encadrement au sol</span><h2 class="display" id="coach-title">Zouhir Boumenir, grappling et JJB</h2>
        <div class="coaches-grid">{club.coaches.map(c => <article class="coach-card"><div class="coach-media"><img src={c.photo} alt={c.alt} width="900" height="720" loading="lazy" decoding="async" /></div><div class="coach-body"><span class="coach-role mono">{c.role}</span><h3 class="display coach-name">{c.name}</h3><p class="coach-qualif mono">{c.qualif}</p><p>{c.description}</p><a href={c.sourceUrl} target="_blank" rel="noopener noreferrer" class="club-source-link">Présentation du coach sur clubmma.fr ↗</a></div></article>)}</div>
      </section>}

      <section class="club-schedule-section" id="planning" aria-labelledby="schedule-title" data-reveal>
        <span class="kicker">Préparer sa séance</span><h2 class="display" id="schedule-title">{club.scheduleLabel}</h2><p class="club-text-body">{club.scheduleNote}</p>
        <div class="schedule-cta"><p>Choisissez le cours et la salle avant de vous déplacer.</p><a href={club.scheduleUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary">Ouvrir le planning du club ↗</a></div>
      </section>

      <section class="club-faq-section" aria-labelledby="faq-title" data-reveal><span class="kicker">Questions pratiques</span><h2 class="display" id="faq-title">Avant de venir</h2><div class="faq-list">{faqItems.map((f, idx) => <details class="faq-accordion" open={idx === 0}><summary class="faq-question"><span class="faq-title">{f.q}</span><span class="faq-icon" aria-hidden="true">+</span></summary><div class="faq-answer"><p>{f.a}</p>{f.q.includes('horaires') && <a href={club.scheduleUrl} target="_blank" rel="noopener noreferrer">Consulter le planning de {club.name} ↗</a>}</div></details>)}</div></section>

      <section class="club-sources-section" aria-labelledby="sources-title"><span class="kicker">Les sources de cette fiche</span><h2 class="display" id="sources-title">Informations publiées par le club</h2><p>Coordonnées et disciplines vérifiées le <time datetime={club.verifiedAt}>{verifiedDate}</time>. Les horaires et modalités d'inscription sont à consulter auprès de la salle.</p><ul>{club.sources.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a></li>)}</ul></section>
    </div>

    <aside class="club-sidebar" aria-label="Informations et autres clubs">
      <div class="sidebar-box"><h2 class="display">Pour venir au club</h2><dl class="club-practical-list"><div><dt>Adresse</dt><dd>{club.address}</dd></div>{club.metro && <div><dt>Accès</dt><dd>{club.metro}</dd></div>}{club.phone && <div><dt>Téléphone</dt><dd><a href={`tel:${club.phone.replace(/\s/g, '')}`}>{club.phone}</a></dd></div>}<div><dt>Site du club</dt><dd><a href={club.website} target="_blank" rel="noopener noreferrer">{new URL(club.website).hostname.replace(/^www\./, '')} ↗</a></dd></div></dl><a href={club.scheduleUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary">Planning et inscriptions ↗</a></div>
      <div class="sidebar-box"><h2 class="display">D'autres clubs de MMA</h2><div class="other-clubs-mini">{otherClubs.map(oth => <a href={`/clubs/${oth.slug}/`} class="mini-club-link"><span class="kicker">{oth.city}</span><strong>{oth.name}</strong></a>)}</div><a href="/clubs/" class="club-source-link">Voir les cinq clubs de l'annuaire →</a></div>
    </aside>
  </div>
</Base>
