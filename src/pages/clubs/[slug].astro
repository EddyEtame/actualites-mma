---
/* Page individuelle d'un club / salle de MMA en France
   Standard Baffled Bar + SEO / AEO / GEO :
   - Schéma structuré SportsActivityLocation / ExerciseGym
   - Données géographiques exactes, faits vérifiables
   - Photos authentiques de boxe et ring avec attributs ALT descriptifs
   - FAQ balisée FAQPage
   - Conversion forte et naturelle vers https://clubmma.fr/ */
import Base from '../../layouts/Base.astro';
import clubs from '../../data/clubs.json';

export function getStaticPaths() {
  return clubs.map(club => ({
    params: { slug: club.slug },
    props: { club }
  }));
}

const { club } = Astro.props;
const otherClubs = clubs.filter(c => c.slug !== club.slug).slice(0, 3);
const isBoxingCenter = club.slug === 'boxing-center-etats-unis';

const faqItems = isBoxingCenter ? [
  {
    q: "Quels sont les équipements disponibles au Boxing Center États-Unis à Toulouse ?",
    a: "Le complexe de 1 200 m² dispose d'un octogone officiel de combat de 7 mètres, de 400 m² de tatamis monoblocs dédiés à la lutte et au grappling, de 2 rings de boxe anglaise compétition et d'un pôle de préparation physique."
  },
  {
    q: "Peut-on débuter le MMA au Boxing Center sans expérience préalable en combat ?",
    a: "Oui. Des créneaux 'MMA Débutants' et 'Fondamentaux Sol' sont programmés chaque semaine pour apprendre les bases en toute sécurité sous l'encadrement de coachs diplômés d'État."
  },
  {
    q: "Qui encadre les entraînements de MMA et de boxe au Boxing Center Toulouse ?",
    a: "Les cours de sol, lutte et travail contre la cage sont dirigés par Zouhir Boumenir (BPJEPS Lutte/Grappling, Ceinture Noire JJB). Le striking et la boxe anglaise sont encadrés par des entraîneurs diplômés d'État dont Coach Guillaume."
  },
  {
    q: "Comment réserver un cours d'essai ou s'inscrire ?",
    a: "Les réservations de séances d'essai et la consultation des plannings complets s'effectuent directement en ligne sur le site officiel clubmma.fr."
  }
] : [
  {
    q: `Quelles disciplines sont enseignées à ${club.name} ?`,
    a: `Le club propose : ${club.disciplines ? club.disciplines.join(', ') : 'MMA et sports de combat'}.`
  },
  {
    q: `Où se situe ${club.name} à ${club.city} ?`,
    a: `La salle est située à l'adresse suivante : ${club.address || club.city}.`
  }
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SportsActivityLocation",
  "name": club.name,
  "description": club.description,
  "image": `https://prise-mma.fr${club.image}`,
  "url": `https://prise-mma.fr/clubs/${club.slug}/`,
  "telephone": club.phone || undefined,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": club.address || club.city,
    "addressLocality": club.city,
    "postalCode": club.postalCode || "31200",
    "addressRegion": club.region || "Occitanie",
    "addressCountry": "FR"
  },
  "geo": club.geo ? {
    "@type": "GeoCoordinates",
    "latitude": club.geo.latitude,
    "longitude": club.geo.longitude
  } : undefined,
  "amenityFeature": [
    { "@type": "LocationFeatureSpecification", "name": "Octogone de combat", "value": club.cage || "Cage MMA" },
    { "@type": "LocationFeatureSpecification", "name": "Tatamis sol", "value": club.tatami || "200 m²" },
    { "@type": "LocationFeatureSpecification", "name": "Superficie", "value": club.surface || "Complexe sportif" }
  ],
  "sameAs": isBoxingCenter ? ["https://clubmma.fr/"] : undefined
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Base
  title={`${club.name} (${club.city}) — Salle MMA, Octogone 7m & Cours`}
  description={`Fiche officielle ${club.name} à ${club.city} : installations de ${club.surface}, octogone ${club.cage || 'officiel'}, coachs diplômés, plannings et cours d'essai.`}
  image={club.image}
  currentNav="clubs"
>
  <!-- Données structurées SEO / GEO / AEO -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="club-page-hero">
    <div class="club-hero-bg">
      <img src={club.image} alt={club.imageAlt} fetchpriority="high" />
      <div class="club-hero-overlay"></div>
    </div>

    <div class="wrap club-hero-content" data-reveal>
      <nav class="breadcrumbs mono" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a> <span>/</span>
        <a href="/clubs/">Clubs</a> <span>/</span>
        <span class="active">{club.name}</span>
      </nav>

      <div class="club-header-badge mono">
        <span>📍 {club.city}</span>
        {isBoxingCenter && <span class="badge-partner">PÔLE OFFICIEL RECOMMANDÉ</span>}
      </div>

      <h1 class="display club-page-title">{club.name}</h1>
      <p class="club-lead-desc">{club.description}</p>

      {club.address && (
        <p class="club-address-bar mono">
          <strong>Adresse :</strong> {club.address} {club.metro && <span>• {club.metro}</span>}
        </p>
      )}

      {isBoxingCenter && (
        <div class="club-cta-row">
          <a href="https://clubmma.fr/" target="_blank" rel="noopener noreferrer" class="btn btn--primary" style="font-size: 1rem; padding: 0.9rem 2rem;">
            Réserver un cours d'essai sur clubmma.fr ↗
          </a>
          <a href="#planning" class="btn btn--ghost" style="font-size: 0.95rem;">
            Consulter le planning des cours ↓
          </a>
        </div>
      )}
    </div>
  </div>

  <div class="wrap club-main-layout">
    <div class="club-content-col">

      <!-- Fiche technique des installations -->
      <section class="club-specs-section" data-reveal>
        <span class="kicker">Infrastructures & Équipements</span>
        <h2 class="display">Plateau technique de combat</h2>

        <div class="specs-grid-cards mono">
          <div class="spec-card">
            <span class="spec-label">Superficie</span>
            <strong class="spec-value">{club.surface || '400 m²'}</strong>
            <span class="spec-sub">Espace dédié combat</span>
          </div>
          <div class="spec-card">
            <span class="spec-label">Cage</span>
            <strong class="spec-value" style="color: var(--teal);">{club.cage || 'Espace cage'}</strong>
            <span class="spec-sub">Normes officielles</span>
          </div>
          <div class="spec-card">
            <span class="spec-label">Tatamis</span>
            <strong class="spec-value">{club.tatami || '200 m²'}</strong>
            <span class="spec-sub">Lutte & Grappling sol</span>
          </div>
          {club.rings && (
            <div class="spec-card">
              <span class="spec-label">Rings</span>
              <strong class="spec-value">{club.rings}</strong>
              <span class="spec-sub">Boxe anglaise compétition</span>
            </div>
          )}
        </div>
      </section>

      <!-- Présentation détaillée -->
      <section class="club-about-section" data-reveal>
        <span class="kicker">L'esprit de la salle</span>
        <h2 class="display">Formation, encadrement et philosophie</h2>
        <div class="club-text-body">
          <p class="lead">{club.longDescription || club.description}</p>
          <p>La pratique du Mixed Martial Arts requiert une approche décloisonnée associant frappes percutantes, lutte de corps-à-corps et soumissions au sol. {club.name} met à disposition des pratiquants de tous niveaux un cadre d'apprentissage rigoureux et sécurisé.</p>
        </div>

        <div class="disciplines-pills mono">
          {club.disciplines && club.disciplines.map(d => (
            <span class="pill">{d}</span>
          ))}
        </div>
      </section>

      <!-- Staff & Coachs avec VRAIES PHOTOS D'ACTION -->
      {club.coaches && club.coaches.length > 0 && (
        <section class="club-coaches-section" data-reveal>
          <span class="kicker">Équipe technique & Expérience</span>
          <h2 class="display">L'encadrement en action</h2>

          <div class="coaches-grid">
            {club.coaches.map(c => (
              <div class="coach-card">
                <div class="coach-media">
                  <img src={c.photo} alt={c.alt || `Coach ${c.name} à l'entraînement`} width="360" height="400" loading="lazy" />
                </div>
                <div class="coach-body">
                  <span class="coach-role mono">{c.role}</span>
                  <h3 class="display coach-name">{c.name}</h3>
                  <p class="coach-qualif mono">{c.qualif}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Planning des cours -->
      {club.schedule && (
        <section class="club-schedule-section" id="planning" data-reveal>
          <span class="kicker">Horaires & Créneaux</span>
          <h2 class="display">Planning hebdomadaire des entraînements</h2>

          <div class="schedule-table-box">
            <table class="schedule-table mono">
              <thead>
                <tr>
                  <th>Jour</th>
                  <th>Créneaux & Disciplines</th>
                </tr>
              </thead>
              <tbody>
                {club.schedule.map(s => (
                  <tr>
                    <td class="sched-day"><strong>{s.day}</strong></td>
                    <td class="sched-hours">{s.hours}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {isBoxingCenter && (
            <div class="schedule-cta">
              <p>Envie de faire votre premier entraînement dans l'octogone ?</p>
              <a href="https://clubmma.fr/" target="_blank" rel="noopener noreferrer" class="btn btn--primary">
                Consulter les tarifs & s'inscrire sur clubmma.fr →
              </a>
            </div>
          )}
        </section>
      )}

      <!-- Galerie photos réelles du club (boxeurs en action, cage, ring) -->
      {club.gallery && club.gallery.length > 0 && (
        <section class="club-gallery-section" data-reveal>
          <span class="kicker">Immersion Visuelle Réelle</span>
          <h2 class="display">Dans le ring, la cage et sur les tatamis</h2>
          <p class="lede" style="margin-bottom: 1.5rem; font-size: 0.95rem; color: var(--ash);">Photographies réelles des séances d'entraînement, des sparrings et des équipements officiels du club.</p>

          <div class="gallery-grid">
            {club.gallery.map(item => {
              const src = typeof item === 'string' ? item : item.src;
              const alt = typeof item === 'string' ? `Installation ${club.name}` : item.alt;
              return (
                <figure class="gallery-item">
                  <img src={src} alt={alt} width="640" height="420" loading="lazy" decoding="async" />
                  <figcaption class="sr-only">{alt}</figcaption>
                </figure>
              );
            })}
          </div>
        </section>
      )}

      <!-- FAQ structurée AEO/GEO : Réponses directes aux requêtes des utilisateurs -->
      <section class="club-faq-section" data-reveal>
        <span class="kicker">Questions Fréquentes & Renseignements</span>
        <h2 class="display">Tout ce qu'il faut savoir avant de venir</h2>

        <div class="faq-list">
          {faqItems.map((f, idx) => (
            <details class="faq-accordion" open={idx === 0}>
              <summary class="faq-question">
                <span class="faq-title">{f.q}</span>
                <span class="faq-icon" aria-hidden="true">+</span>
              </summary>
              <div class="faq-answer">
                <p>{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </section>

    </div>

    <!-- Sidebar pratique -->
    <aside class="club-sidebar">
      <div class="sidebar-box">
        <h4 class="display">Informations clés</h4>
        <ul class="practical-list mono">
          <li><strong>Ville :</strong> {club.city}</li>
          {club.surface && <li><strong>Superficie :</strong> {club.surface}</li>}
          {club.cage && <li><strong>Cage :</strong> {club.cage}</li>}
          {club.phone && <li><strong>Téléphone :</strong> {club.phone}</li>}
          {club.website && (
            <li>
              <strong>Site web :</strong>
              <a href={club.website} target={isBoxingCenter ? '_blank' : '_self'} rel="noopener noreferrer" style="color: var(--teal);">
                {isBoxingCenter ? 'clubmma.fr ↗' : 'Visiter le site'}
              </a>
            </li>
          )}
        </ul>
      </div>

      <div class="sidebar-box">
        <h4 class="display">Autres clubs en France</h4>
        <div class="other-clubs-mini">
          {otherClubs.map(oth => (
            <a href={`/clubs/${oth.slug}/`} class="mini-club-link">
              <span class="kicker">{oth.city}</span>
              <strong>{oth.name}</strong>
            </a>
          ))}
        </div>
      </div>
    </aside>
  </div>
</Base>
