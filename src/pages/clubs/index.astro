---
/* Annuaire des clubs et salles de MMA en France
   Met en avant de façon naturelle et légitime le pôle Boxing Center États-Unis (clubmma.fr) */
import Base from '../../layouts/Base.astro';
import clubs from '../../data/clubs.json';

const bcGym = clubs.find(c => c.slug === 'boxing-center-etats-unis') || clubs[0];
const otherClubs = clubs.filter(c => c.slug !== 'boxing-center-etats-unis');
---

<Base
  title="Clubs et Salles de MMA en France — Où s'entraîner"
  description="Trouver une salle de MMA en France : Paris, Toulouse, Lyon, Marseille. Annuaire des clubs équipés d'octogones et encadrés par des coachs professionnels."
  image="/assets/img/hero-cage-mma.webp"
  currentNav="clubs"
>
  <div class="wrap archive-page">
    <header class="archive-header" data-reveal>
      <span class="kicker">Infrastructures & Pratique</span>
      <h1 class="display">Les clubs et salles de MMA en France</h1>
      <p class="lede">De la cage d'octogone aux tatamis de grappling : où s'entraîner dans les meilleures conditions techniques et sécuritaires pour progresser.</p>
    </header>

    <!-- SPOTLIGHT MAJEUR : BOXING CENTER ÉTATS-UNIS (clubmma.fr) -->
    <section class="bc-spotlight-section" data-reveal>
      <div class="spotlight-card">
        <div class="spotlight-visual-col">
          <!-- Grande photo principale : dégagée, lumineuse, zéro obstruction -->
          <div class="spotlight-main-media">
            <img
              id="spotlightMainImg"
              src="/assets/img/boxing-center-etats-unis-vue-ensemble-ring-tatamis-cage.webp"
              alt="Vue d'ensemble du complexe Boxing Center États-Unis à Toulouse : 1 200 m², ring officiel, tatamis et octogone 7 mètres"
              width="1280"
              height="720"
              fetchpriority="high"
            />
            <div class="spotlight-badge mono">PÔLE MAJEUR SUD-OUEST</div>
            <div class="spotlight-caption-bar mono" id="spotlightCaption">
              Vue d'ensemble • Complexe 1 200 m² (Ring, Cage 7m, Tatamis 400m²)
            </div>
          </div>

          <!-- Espace sous l'image principale : galerie des 5 clichés réels -->
          <div class="spotlight-gallery-below">
            <div class="gallery-below-header mono">
              <span>Aperçu immersif (cliquez pour afficher) :</span>
            </div>
            <div class="spotlight-thumbs-grid" id="spotlightThumbsGrid">
              <button
                type="button"
                class="sp-thumb is-active"
                data-src="/assets/img/boxing-center-etats-unis-vue-ensemble-ring-tatamis-cage.webp"
                data-alt="Vue d'ensemble du complexe Boxing Center États-Unis à Toulouse : 1 200 m², ring officiel, tatamis et octogone 7 mètres"
                data-caption="Vue d'ensemble • Complexe 1 200 m² (Ring, Cage 7m, Tatamis 400m²)"
                data-pos="center center"
                aria-label="Afficher la vue d'ensemble"
              >
                <img src="/assets/img/boxing-center-etats-unis-vue-ensemble-ring-tatamis-cage.webp" alt="Vue d'ensemble 1 200 m²" />
                <span class="sp-thumb-lbl mono">Vue Générale</span>
              </button>

              <button
                type="button"
                class="sp-thumb"
                data-src="/assets/img/boxing-center-etats-unis-sparring-boxe-anglaise-casques-ring.webp"
                data-alt="Deux boxeurs casqués en plein assaut de boxe anglaise avec gants de combat et coquille sur le ring officiel à Toulouse"
                data-caption="Boxe Anglaise • Sparring dirigé avec casques et gants de combat sur ring officiel"
                data-pos="center center"
                aria-label="Afficher les assauts sur le ring de boxe"
              >
                <img src="/assets/img/boxing-center-etats-unis-sparring-boxe-anglaise-casques-ring.webp" alt="Assauts de boxe anglaise casqués sur le ring" />
                <span class="sp-thumb-lbl mono">Boxe Ring</span>
              </button>

              <button
                type="button"
                class="sp-thumb"
                data-src="/assets/img/boxing-center-etats-unis-cours-mma-frappe-cage-octogone.webp"
                data-alt="Entraînement de MMA et percussions devant l'octogone officiel de 7 mètres au Boxing Center"
                data-caption="MMA & Octogone • Travail technique percussions et cage 7 mètres"
                data-pos="center 20%"
                aria-label="Afficher l'entraînement dans la cage de MMA"
              >
                <img src="/assets/img/boxing-center-etats-unis-cours-mma-frappe-cage-octogone.webp" alt="Entraînement frappes et cage de combat" />
                <span class="sp-thumb-lbl mono">MMA Cage</span>
              </button>

              <button
                type="button"
                class="sp-thumb"
                data-src="/photos/encadrement-coach-boxe-colomiers-1440.jpg"
                data-alt="Coach Guillaume serrant les lacets des gants de boxe d'un combattant sur le ring"
                data-caption="Coach Guillaume • Striking & préparation combat sur le ring"
                data-pos="top center"
                aria-label="Afficher Coach Guillaume"
              >
                <img src="/photos/encadrement-coach-boxe-colomiers-1440.jpg" alt="Coach Guillaume encadrement boxe" />
                <span class="sp-thumb-lbl mono">Coach Guillaume</span>
              </button>

              <button
                type="button"
                class="sp-thumb"
                data-src="/assets/img/photo_coach_zouhir.webp"
                data-alt="Coach Zouhir Boumenir, responsable du pôle sol, lutte et cage au Boxing Center"
                data-caption="Coach Zouhir Boumenir • Head Coach Sol, Lutte & JJB (Ceinture Noire)"
                data-pos="top center"
                aria-label="Afficher Coach Zouhir"
              >
                <img src="/assets/img/photo_coach_zouhir.webp" alt="Coach Zouhir Boumenir" />
                <span class="sp-thumb-lbl mono">Coach Zouhir</span>
              </button>
            </div>
          </div>

          <script is:inline>
            (function() {
              function initSpotlightGallery() {
                var grid = document.getElementById('spotlightThumbsGrid');
                var mainImg = document.getElementById('spotlightMainImg');
                var caption = document.getElementById('spotlightCaption');
                if (!grid || !mainImg) return;

                var thumbs = grid.querySelectorAll('.sp-thumb');
                thumbs.forEach(function(btn) {
                  btn.addEventListener('click', function() {
                    thumbs.forEach(function(t) { t.classList.remove('is-active'); });
                    btn.classList.add('is-active');

                    var newSrc = btn.getAttribute('data-src');
                    var newAlt = btn.getAttribute('data-alt');
                    var newCap = btn.getAttribute('data-caption');
                    var newPos = btn.getAttribute('data-pos') || 'top center';

                    mainImg.classList.add('is-fading');
                    setTimeout(function() {
                      mainImg.src = newSrc;
                      mainImg.alt = newAlt;
                      mainImg.style.objectPosition = newPos;
                      if (caption) caption.textContent = newCap;
                      mainImg.classList.remove('is-fading');
                    }, 120);
                  });
                });
              }

              if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initSpotlightGallery);
              } else {
                initSpotlightGallery();
              }
            })();
          </script>
        </div>

        <div class="spotlight-body">
          <div class="spotlight-header">
            <span class="kicker">Salle recommandée par PRISE MMA</span>
            <h2 class="display">Boxing Center (Toulouse — États-Unis)</h2>
            <p class="spotlight-address mono">📍 388 avenue des États-Unis, 31200 Toulouse</p>
          </div>

          <p class="spotlight-text">
            Implantée au nord de Toulouse, la salle <strong>Boxing Center États-Unis</strong> est le fleuron des sports de combat dans la région toulousaine. Conçue pour répondre aux exigences des combattants professionnels comme des débutants, elle propose un équipement unique :
          </p>

          <div class="spotlight-specs-grid mono">
            <div class="spec-item">
              <strong>1 200 m²</strong>
              <span>Superficie totale</span>
            </div>
            <div class="spec-item">
              <strong>7 mètres</strong>
              <span>Octogone officiel</span>
            </div>
            <div class="spec-item">
              <strong>400 m²</strong>
              <span>Tapis sol & lutte</span>
            </div>
            <div class="spec-item">
              <strong>2 rings</strong>
              <span>Boxe compétition</span>
            </div>
          </div>

          <p class="spotlight-coaching">
            Encadrement d'élite sous la direction de coachs diplômés d'État, dont <strong>Zouhir Boumenir</strong> (BPJEPS Lutte/Grappling, ceinture noire JJB) pour les sections sol et combat contre la cage, et <strong>Coach Guillaume</strong> (Diplômé d'État Boxe Anglaise & Savate) pour le striking et la préparation combat.
          </p>

          <div class="spotlight-actions">
            <a href="/clubs/boxing-center-etats-unis/" class="btn btn--primary" style="font-size: 0.95rem;">
              Fiche complète du complexe & horaires →
            </a>
            <a href="https://clubmma.fr/" target="_blank" rel="noopener noreferrer" class="btn btn--teal" style="font-size: 0.95rem;">
              Site officiel clubmma.fr ↗
            </a>
            <a href="/actualites/zouhir-boumenir-coach-sol-boxing-center-toulouse/" class="btn btn--ghost">
              Interview du coach sol →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Annuaire des autres grands clubs français -->
    <section class="all-clubs-section" data-reveal>
      <div class="ed-head">
        <span class="kicker">Annuaire National</span>
        <h2 class="display">Les autres salles de référence dans l'Hexagone</h2>
        <p class="lede">Sélection des clubs réputés pour la formation de compétiteurs et la qualité de l'encadrement.</p>
      </div>

      <div class="clubs-grid" data-reveal-group>
        {otherClubs.map(c => (
          <a class="club-card" href={`/clubs/${c.slug}/`} data-reveal>
            <div class="club-card__visual">
              <img src={c.image} alt={c.imageAlt} width="640" height="360" loading="lazy" decoding="async" />
            </div>
            <div class="club-card__body">
              <span class="kicker">{c.city}</span>
              <h3 class="display">{c.name}</h3>
              <p>{c.description}</p>
              <div class="club-card__tags">
                {c.disciplines && c.disciplines.map(d => (
                  <span class="tag mono">{d}</span>
                ))}
              </div>
              <span class="mono" style="font-size: 0.78rem; color: var(--teal); margin-top: 0.8rem; display: inline-block;">
                Voir les équipements & horaires →
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Guide débutant : bien choisir sa salle de MMA -->
    <section class="guide-debutant-section" data-reveal>
      <div class="guide-box">
        <span class="kicker">Guide Pratique</span>
        <h2 class="display">3 critères essentiels pour choisir sa salle de MMA</h2>
        <div class="guide-steps-grid">
          <div class="step-card">
            <span class="step-num mono">01</span>
            <h3 class="display">La surface de tatamis & la paroi de cage</h3>
            <p>Le MMA moderne nécessite au minimum 150 m² d'espace de tapis propre et des protections murales pour pratiquer le <em>cage control</em> sans risque de blessure.</p>
          </div>
          <div class="step-card">
            <span class="step-num mono">02</span>
            <h3 class="display">Des coachs certifiés par discipline</h3>
            <p>Exigez des diplômes d'État (BPJEPS, DEJEPS) ou des ceintures noires reconnues pour l'enseignement du JJB, de la lutte et de la boxe thaïlandaise.</p>
          </div>
          <div class="step-card">
            <span class="step-num mono">03</span>
            <h3 class="display">Des créneaux adaptés à son niveau</h3>
            <p>Une bonne salle sépare les cours fondamentaux (sécurité, technique) des créneaux de sparring engagé réservés aux compétiteurs confirmés.</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>
