---
import Base from '../../layouts/Base.astro';
import clubs from '../../data/clubs.json';

const bcGym = clubs.find(c => c.slug === 'boxing-center-etats-unis')!;
const otherClubs = clubs.filter(c => c.slug !== bcGym.slug);
const verifiedDate = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${bcGym.verifiedAt}T12:00:00Z`));
const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Clubs de MMA en France',
  itemListElement: clubs.map((club, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: club.name,
    url: `https://actu-mma.com/clubs/${club.slug}/`
  }))
};
---

<Base
  title="Clubs de MMA en France — Toulouse, Paris et Lyon"
  description="Cinq clubs de MMA à Toulouse, Paris et Villeurbanne : adresses vérifiées, disciplines, coachs et liens vers les plannings des salles."
  currentNav="clubs"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(listSchema)} />
  <div class="wrap archive-page">
    <header class="archive-header" data-reveal>
      <span class="kicker">La pratique · Clubs de MMA</span>
      <h1 class="display">Trouver sa salle.<br />Entrer dans le MMA.</h1>
      <p class="lede">Toulouse, Paris, métropole de Lyon : cinq clubs, leurs disciplines et les informations utiles pour choisir votre premier entraînement.</p>
      <p class="club-source-note mono">Coordonnées et disciplines vérifiées le <time datetime={bcGym.verifiedAt}>{verifiedDate}</time> · Sources des clubs sur chaque fiche</p>
    </header>

    <section class="bc-spotlight-section" aria-labelledby="spotlight-title" data-reveal>
      <div class="spotlight-card">
        <div class="spotlight-practice-col">
          <span class="kicker">Toulouse · États-Unis</span>
          <span class="spotlight-practice-title display">MMA.<br />Cage.<br />Travail au sol.</span>
          <div class="spotlight-practice-facts">
            <div><span class="mono">01</span><p><strong>{bcGym.cage}</strong><span>Travail contre la paroi</span></p></div>
            <div><span class="mono">02</span><p><strong>{bcGym.tatami} de tatamis</strong><span>Grappling et jiu-jitsu brésilien</span></p></div>
            <div><span class="mono">03</span><p><strong>Débutants et confirmés</strong><span>Cours Asso MMA et MMA jeunes 10–16 ans</span></p></div>
          </div>
          <a class="club-source-link mono" href="https://clubmma.fr/disciplines/" target="_blank" rel="noopener noreferrer">Disciplines sur clubmma.fr ↗</a>
        </div>
        <div class="spotlight-body">
          <span class="kicker">Repère toulousain</span>
          <h2 class="display" id="spotlight-title">{bcGym.name}</h2>
          <p class="spotlight-address mono">{bcGym.address}</p>
          <p class="spotlight-text">{bcGym.longDescription}</p>
          <p class="spotlight-coaching"><strong>Zouhir Boumenir</strong>, ceinture noire de jiu-jitsu brésilien, encadre le grappling et le JJB dans cette salle. Le planning du club détaille les créneaux MMA & Sol de la saison 2026–2027.</p>
          <div class="spotlight-actions">
            <a href={`/clubs/${bcGym.slug}/`} class="btn btn--primary">Découvrir le pôle MMA →</a>
            <a href={bcGym.scheduleUrl} target="_blank" rel="noopener noreferrer" class="btn btn--ghost">Planning MMA & Sol ↗</a>
          </div>
        </div>
      </div>
    </section>

    <section class="all-clubs-section" aria-labelledby="other-clubs-title" data-reveal>
      <div class="ed-head">
        <span class="kicker">L'annuaire</span>
        <h2 class="display" id="other-clubs-title">D'autres terrains de progression</h2>
        <p class="lede">MMA, grappling, lutte ou Luta Livre : retrouvez l'adresse et le planning de chaque club.</p>
      </div>
      <div class="clubs-grid" data-reveal-group>
        {otherClubs.map(c => (
          <a class="club-card club-card--directory" href={`/clubs/${c.slug}/`} data-reveal>
            <div class="club-card__identity"><span class="mono">{c.region}</span><strong class="display" aria-hidden="true">{c.cityCode}</strong><span>{c.city}</span></div>
            <div class="club-card__body">
              <h3 class="display">{c.name}</h3>
              <p>{c.description}</p>
              <p class="club-card-address mono">{c.address}</p>
              <div class="club-card__tags">{c.disciplines.map(d => <span class="tag mono">{d}</span>)}</div>
              <span class="club-card-cta mono">Adresse, disciplines & planning →</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="guide-debutant-section" aria-labelledby="first-course-title" data-reveal>
      <div class="guide-box">
        <span class="kicker">Avant le premier cours</span>
        <h2 class="display" id="first-course-title">Trois questions à poser à votre salle</h2>
        <div class="guide-steps-grid">
          <div class="step-card"><span class="step-num mono">01</span><h3 class="display">Quel cours pour débuter ?</h3><p>Demandez quel groupe correspond à votre expérience et comment les exercices d'opposition sont adaptés lors du premier cours.</p></div>
          <div class="step-card"><span class="step-num mono">02</span><h3 class="display">Qui encadre la séance ?</h3><p>Renseignez-vous sur l'entraîneur, sa qualification et les disciplines enseignées : MMA, travail au sol et lutte ne désignent pas le même cours.</p></div>
          <div class="step-card"><span class="step-num mono">03</span><h3 class="display">Faut-il réserver et s'équiper ?</h3><p>Vérifiez le créneau, les modalités de l'essai et le matériel demandé directement auprès du club avant de vous déplacer.</p></div>
        </div>
      </div>
    </section>
  </div>
</Base>
