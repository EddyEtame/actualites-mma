---
/* Hub des organisations de MMA */
import Base from '../../layouts/Base.astro';
import organisations from '../../data/organisations.json';
---

<Base
  title="Organisations MMA — UFC, ARES, Hexagone MMA, PFL, ONE"
  description="Guide complet des ligues de MMA mondiales et françaises : UFC, ARES FC, Hexagone MMA, PFL Europe, ONE Championship et la fédération FMMAF."
  currentNav="organisations"
>
  <div class="wrap archive-page">
    <header class="archive-header" data-reveal>
      <span class="kicker">Écosystème & Ligues</span>
      <h1 class="display">Les organisations de MMA</h1>
      <p class="lede">Chaque ligue possède ses règles, son arène et ses ceintures. Décryptage des circuits mondiaux et des promotions majeures françaises.</p>
    </header>

    <div class="orgs-full-grid" data-reveal-group>
      {organisations.map(o => (
        <article class="org-archive-card" data-reveal>
          <div class="card-badge-top" style={`background: ${o.accent};`}>
            <span class="display">{o.badge}</span>
          </div>
          <div class="card-inner">
            <span class="kicker">{o.fullName}</span>
            <h2 class="display org-name-title">
              <a href={`/organisations/${o.slug}/`}>{o.name}</a>
            </h2>
            <p>{o.description}</p>
            <div class="org-card-specs mono">
              <span>🏟️ {o.cage}</span>
              <span>📺 {o.broadcast}</span>
            </div>
            <a href={`/organisations/${o.slug}/`} class="btn btn--ghost" style="margin-top: 1rem; width: 100%;">
              Voir la fiche complète & les Français →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Base>
