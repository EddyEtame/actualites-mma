---
import Base from '../../layouts/Base.astro';
import events from '../../data/events.json';
import { formatDate, upcomingEvents } from '../../lib/editorial.mjs';

export function getStaticPaths() {
  return events.map(event => ({ params: { slug: event.slug }, props: { event } }));
}

const { event } = Astro.props;
const otherEvents = upcomingEvents(events).filter(item => item.slug !== event.slug);
const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: event.title,
  sport: 'Mixed Martial Arts',
  startDate: event.startAt || event.date,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: { '@type': 'Place', name: event.venue },
  description: event.description,
  url: 'https://actu-mma.com/evenements/' + event.slug + '/',
};
---

<Base title={event.title + ' — Date et combats confirmés'} description={event.description} image={event.image} currentNav="evenements">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(eventSchema)} />

  <div class="event-page-hero" style={'--org-accent: ' + event.accent + ';'}>
    <div class="event-hero-bg">
      <img src={event.image} alt={event.imageAlt} fetchpriority="high" />
      <div class="event-hero-overlay"></div>
    </div>
    <div class="wrap event-hero-content" data-reveal>
      <nav class="breadcrumbs mono" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a><span>/</span><a href="/evenements/">Combats</a><span>/</span><span>{event.org}</span>
      </nav>
      <div class="event-header-badge" style={'background: ' + event.accent + ';'}><span>{event.badge}</span></div>
      <h1 class="display event-page-title">{event.title}</h1>
      <p class="event-lead-desc">{event.description}</p>
      <p class="mono editorial-image-note">{event.imageCaption} {event.imageSource?.pageUrl && <a href={event.imageSource.pageUrl} target="_blank" rel="noopener noreferrer">Source de la photo ↗</a>}</p>
      <div class="event-quick-info mono">
        <div class="info-pill"><span class="lbl">Date locale de l'événement</span><strong>{formatDate(event.date, { weekday: 'long' })}</strong></div>
        <div class="info-pill"><span class="lbl">Horaires</span><strong>{event.time}</strong></div>
        <div class="info-pill"><span class="lbl">Lieu</span><strong>{event.venue}</strong></div>
        <div class="info-pill"><span class="lbl">Diffusion</span><strong>{event.broadcaster}</strong></div>
      </div>
      {event.startAt && (
        <div class="event-countdown-box">
          <span class="mono countdown-title">{event.countdownLabel}</span>
          <div class="mono event-clock" data-event-clock={event.startAt}>
            <time datetime={event.startAt}>{event.time}</time>
          </div>
          <p class="mono">Horaire annoncé par l'organisation. Le compte à rebours ne mesure pas l'heure d'entrée des combattants.</p>
        </div>
      )}
    </div>
  </div>

  <div class="wrap event-main-layout">
    <div class="event-content-col">
      <section class="fight-card-section" data-reveal>
        <span class="kicker">Affiches vérifiées</span>
        <h2 class="display">Les combats annoncés</h2>
        <p class="lede">{event.cardScope}</p>
        <div class="bouts-list">
          {event.fights.map(bout => (
            <div class={'bout-row' + (bout.role === 'Combat principal' ? ' main-event' : '')}>
              <div class="bout-header mono">
                <span class="bout-rank">{bout.role}</span>
                <span class="bout-weight">{bout.weight}</span>
                {bout.title && <span class="bout-title-tag">{bout.title}</span>}
              </div>
              <div class="bout-fighters">
                <div class="corner red-corner"><span class="corner-indicator"></span><strong class="fighter-name display">{bout.red}</strong></div>
                <div class="vs-badge mono">VS</div>
                <div class="corner blue-corner"><strong class="fighter-name display">{bout.blue}</strong><span class="corner-indicator"></span></div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="event-training-promo" data-reveal>
        <div class="promo-box">
          <span class="kicker">De la carte au tapis</span>
          <h3 class="display">Travailler les transitions du MMA</h3>
          <p>Le clinch, les amenées au sol et le grappling relient les phases du combat. Retrouvez les informations sur les cours de MMA au Boxing Center Toulouse.</p>
          <a href="https://clubmma.fr/" target="_blank" rel="noopener noreferrer" class="btn btn--teal">Découvrir les cours de MMA ↗</a>
        </div>
      </section>
    </div>

    <aside class="event-sidebar">
      <div class="sidebar-box">
        <h2 class="display">Sources de la carte</h2>
        <p>Vérifiées le <time datetime={event.verifiedAt}>{formatDate(event.verifiedAt)}</time>.</p>
        <ul class="practical-list">
          {event.sources.map(source => (
            <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.name} · {source.title} ↗</a></li>
          ))}
        </ul>
        <p>La carte et les horaires peuvent évoluer avant l'événement. Les liens ci-dessus donnent accès aux annonces de l'organisation.</p>
      </div>
      {otherEvents.length > 0 && (
        <div class="sidebar-box">
          <h2 class="display">Autres rendez-vous</h2>
          <div class="other-events-mini">
            {otherEvents.map(item => (
              <a href={'/evenements/' + item.slug + '/'} class="mini-event-item">
                <span class="mini-date mono">{formatDate(item.date, { year: undefined })}</span>
                <strong class="mini-title">{item.title}</strong><span class="mini-venue">{item.venue}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </aside>
  </div>
</Base>

<script>
  function setupEventClocks() {
    document.querySelectorAll<HTMLElement>('[data-event-clock]').forEach(box => {
      if (box.dataset.clockReady === 'true') return;
      const target = Date.parse(box.dataset.eventClock || '');
      if (!Number.isFinite(target)) return;
      box.dataset.clockReady = 'true';
      let timer: ReturnType<typeof setInterval> | undefined;
      const tick = () => {
        const remaining = target - Date.now();
        if (remaining <= 0) {
          box.textContent = 'Horaire annoncé atteint · consulter l’organisation pour le suivi.';
          if (timer) clearInterval(timer);
          return;
        }
        const days = Math.floor(remaining / 86400000);
        const hours = Math.floor((remaining % 86400000) / 3600000);
        const minutes = Math.floor((remaining % 3600000) / 60000);
        const seconds = Math.floor((remaining % 60000) / 1000);
        box.textContent = days + ' j · ' + hours + ' h · ' + minutes + ' min · ' + seconds + ' s';
      };
      tick();
      if (target > Date.now()) timer = setInterval(tick, 1000);
      document.addEventListener('astro:before-swap', () => { if (timer) clearInterval(timer); }, { once: true });
    });
  }
  setupEventClocks();
  document.addEventListener('astro:page-load', setupEventClocks);
</script>

<style>
  .event-clock { font-size: clamp(1.4rem, 4vw, 2.4rem); font-weight: 800; padding: 1rem 0; font-variant-numeric: tabular-nums; }
  .editorial-image-note { font-size: .75rem; opacity: .72; margin-top: .8rem; }
  .event-sidebar a { text-decoration: underline; text-underline-offset: .2em; }
  .event-sidebar li { margin: 1rem 0; }
</style>
