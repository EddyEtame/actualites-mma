---
/* Page individuelle d'article / post de blog
   Respecte les standards de la skill 'article-writing' et 'baffled-bar' :
   Typographie éditoriale haute densité, métadonnées Schema.org complètes, maillage interne. */
import Base from '../../layouts/Base.astro';
import articles from '../../data/articles.json';
import { publishedArticles, formatDate } from '../../lib/editorial.mjs';

export function getStaticPaths() {
  return publishedArticles(articles).map(article => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const otherArticles = publishedArticles(articles).filter(a => a.slug !== article.slug).slice(0, 3);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://actu-mma.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Actualités",
      "item": "https://actu-mma.com/actualites/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": article.title,
      "item": `https://actu-mma.com/actualites/${article.slug}/`
    }
  ]
};
---

<Base
  title={article.title}
  description={article.excerpt}
  image={article.image}
  type="article"
  publishedTime={article.publishedAt || article.date}
  modifiedTime={article.updatedAt || article.publishedAt || article.date}
  sources={article.sources || []}
  author={article.author || 'Rédaction PRISE MMA'}
  currentNav="actualites"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <article class="article-page wrap">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs mono" aria-label="Fil d'Ariane">
      <a href="/">Accueil</a> <span>/</span>
      <a href="/actualites/">Actualités</a> <span>/</span>
      <span class="active">{article.kicker}</span>
    </nav>

    <!-- Header de l'article -->
    <header class="article-header" data-reveal>
      <div class="article-meta">
        <span class="kicker">{article.kicker}</span>
        <span class="dot">•</span>
        <time class="mono" datetime={article.date}>
          {new Date(article.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
        <span class="dot">•</span>
        <span class="read-time mono">{article.readTime || '5 min de lecture'}</span>
      </div>

      <h1 class="display article-title">{article.title}</h1>
      <p class="article-excerpt">{article.excerpt}</p>

      <div class="article-author-bar">
        <div class="author-info">
          <span class="author-label mono">Rédigé par</span>
          <strong class="author-name">{article.author || 'Rédaction PRISE MMA'}</strong>
          <span class="author-sub mono">• Sources consultées le {formatDate(article.verifiedAt || article.publishedAt || article.date)}</span>
        </div>
        <div class="author-share-tools mono">
          <button type="button" class="share-btn share-copy" id="copyLinkBtn" title="Copier le lien de l'article">
            <span class="share-icon">🔗</span> <span class="share-txt">Copier le lien</span>
          </button>
          <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(article.title)}&url=${encodeURIComponent(`https://actu-mma.com/actualites/${article.slug}/`)}`} target="_blank" rel="noopener noreferrer" class="share-btn share-x" title="Partager sur X">
            𝕏
          </a>
          <a href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`${article.title} — https://actu-mma.com/actualites/${article.slug}/`)}`} target="_blank" rel="noopener noreferrer" class="share-btn share-wa" title="Partager sur WhatsApp">
            WhatsApp
          </a>
        </div>
      </div>

      <!-- Toast copié -->
      <div id="copyToast" class="copy-toast mono" hidden>
        ✓ Lien de l'article copié dans le presse-papier !
      </div>

      <script is:inline>
        (function() {
          var btn = document.getElementById('copyLinkBtn');
          var toast = document.getElementById('copyToast');
          if (!btn || !toast) return;

          btn.addEventListener('click', function() {
            var url = window.location.href;
            if (navigator.clipboard) {
              navigator.clipboard.writeText(url).then(showToast);
            } else {
              var ta = document.createElement('textarea');
              ta.value = url;
              document.body.appendChild(ta);
              ta.select();
              document.execCommand('copy');
              document.body.removeChild(ta);
              showToast();
            }
          });

          function showToast() {
            toast.hidden = false;
            toast.classList.add('shown');
            var txt = btn.querySelector('.share-txt');
            if (txt) txt.textContent = 'Copié !';
            setTimeout(function() {
              toast.classList.remove('shown');
              setTimeout(function() { toast.hidden = true; }, 300);
              if (txt) txt.textContent = 'Copier le lien';
            }, 2500);
          }
        })();
      </script>
    </header>

    <!-- Image principale -->
    <figure class="article-hero-media" data-reveal>
      <img src={article.image} alt={article.imageAlt} width="1200" height="675" fetchpriority="high" />
      <figcaption class="mono">
        {article.imageCaption || article.imageAlt}
        {article.imageSource?.pageUrl && <a href={article.imageSource.pageUrl} target="_blank" rel="noopener noreferrer">Source de la photo ↗</a>}
      </figcaption>
    </figure>

    <!-- Corps de l'article -->
    <div class="article-layout">
      <div class="article-body">
        {article.content && article.content.map(paragraph => (
          <Fragment set:html={paragraph} />
        ))}

        <section class="article-sources" id="sources">
          <span class="kicker">Vérifier l'information</span>
          <h2>Sources et dates</h2>
          <p>Information vérifiée. Source publiée le <time datetime={article.sourcePublishedAt}>{formatDate(article.sourcePublishedAt)}</time>.</p>
          <ul>{article.sources.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.name} — {source.title || 'Lire la source'}</a>{source.publishedAt && <span class="mono"> · {formatDate(source.publishedAt)}</span>}</li>)}</ul>
        </section>

        <!-- Encadré partenaire subtil : Boxing Center États-Unis -->
        <aside class="club-partner-callout">
          <div class="callout-badge">
            <span class="kicker" style="color: var(--teal);">Pratiquer le MMA</span>
          </div>
          <h3>S'entraîner dans les conditions professionnelles à Toulouse</h3>
          <p>Travail au sol, lutte et striking : découvrez les cours et les installations MMA du <strong>Boxing Center, salle des États-Unis à Toulouse</strong>, sur le site du club.</p>
          <a href="https://clubmma.fr/" target="_blank" rel="noopener noreferrer" class="btn btn--teal">
            Découvrir la salle Boxing Center États-Unis (clubmma.fr) →
          </a>
        </aside>
      </div>

      <!-- Barre latérale -->
      <aside class="article-sidebar">
        <div class="sidebar-box">
          <h4 class="display">Dans la même rubrique</h4>
          <div class="sidebar-posts">
            {otherArticles.map(rel => (
              <a href={`/actualites/${rel.slug}/`} class="sidebar-item">
                <span class="sidebar-kicker">{rel.kicker}</span>
                <h5>{rel.title}</h5>
                <span class="mono sidebar-date">
                  {new Date(rel.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })}
                </span>
              </a>
            ))}
          </div>
        </div>

        <div class="sidebar-box box-orgs">
          <h4 class="display">Organisations</h4>
          <ul class="sidebar-org-list">
            <li><a href="/organisations/ufc/">UFC (Monde)</a></li>
            <li><a href="/organisations/ares/">ARES FC (France)</a></li>
            <li><a href="/organisations/hexagone-mma/">Hexagone MMA (France)</a></li>
            <li><a href="/organisations/pfl/">PFL Europe</a></li>
          </ul>
        </div>
      </aside>
    </div>

    <!-- Articles liés -->
    <section class="related-section" data-reveal>
      <div class="related-head">
        <span class="kicker">Continuer la lecture</span>
        <h2 class="display">Dernières analyses et comptes-rendus</h2>
      </div>
      <div class="related-grid">
        {otherArticles.map(item => (
          <a href={`/actualites/${item.slug}/`} class="related-card">
            <div class="related-media">
              <img src={item.image} alt={item.imageAlt} width="480" height="270" loading="lazy" decoding="async" />
            </div>
            <div class="related-copy">
              <span class="kicker">{item.kicker}</span>
              <h3 class="display">{item.title}</h3>
              <p>{item.excerpt.slice(0, 110)}…</p>
            </div>
          </a>
        ))}
      </div>
    </section>

  </article>
</Base>
