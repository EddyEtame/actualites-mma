---
/* PRISE MMA — Layout de base unifié
   Respecte les standards Baffled Bar : SEO sémantique complet, polices locales optimisées,
   header compact au scroll, tiroir mobile accessible, maillage interne et liens externes. */
import articles from '../data/articles.json';
import { publishedArticles, formatDate } from '../lib/editorial.mjs';
interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  currentNav?: string;
  sources?: { name: string; url: string; publishedAt?: string }[];
}

const {
  title,
  description,
  image = '/assets/fighters/ciryl-gane.webp',
  canonical = new URL(Astro.url.pathname, 'https://actu-mma.com').href,
  type = 'website',
  publishedTime,
  modifiedTime,
  author = 'Rédaction PRISE MMA',
  currentNav = '',
  sources = []
} = Astro.props;

const siteUrl = 'https://actu-mma.com';
const absoluteImageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;
const latestArticles = publishedArticles(articles).slice(0, 6);
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — PRISE MMA</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph / Facebook -->
  <meta property="og:site_name" content="PRISE MMA" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={`${title} — PRISE MMA`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={absoluteImageUrl} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} — PRISE MMA`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteImageUrl} />

  <!-- Favicon -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="Actualités MMA" href="/rss.xml" />

  <!-- Preconnect for fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Stylesheets -->
  <link rel="stylesheet" href="/assets/css/fonts.css" />
  <link rel="stylesheet" href="/assets/css/base.css" />
  <link rel="stylesheet" href="/assets/css/home.css" />
  <link rel="stylesheet" href="/assets/css/motion.css" />
  <link rel="stylesheet" href="/assets/css/editorial.css" />

  <!-- JSON-LD Structured Data -->
  {type === 'article' ? (
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "NewsArticle",
      "headline": title,
      "description": description,
      "image": [absoluteImageUrl],
      "datePublished": publishedTime,
      "dateModified": modifiedTime || publishedTime,
      "author": [{
        "@type": "Organization",
        "name": author
      }],
      "publisher": {
        "@type": "NewsMediaOrganization",
        "name": "PRISE MMA",
        "url": siteUrl
      },
      "citation": sources.map(source => ({ "@type": "CreativeWork", "url": source.url, "name": source.name, "datePublished": source.publishedAt })),
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonical
      },
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": [".article-title", ".article-excerpt"]
      }
    })} />
  ) : (
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "PRISE MMA",
      "url": siteUrl,
      "inLanguage": "fr-FR",
      "description": "Média MMA indépendant de référence. Combats à venir, résultats, organisations, clubs et combattants français."
    })} />
  )}

</head>

<body>
  <a class="skip" href="#contenu">Aller au contenu</a>

  <!-- ========================== SITE HEADER ========================== -->
  <header>
    <div class="header-inner">
      <a class="brand" href="/" aria-label="PRISE MMA Accueil">
        <span class="brand__mark">PRISE</span>
        <span class="brand__tag mono">MMA</span>
      </a>

      <nav class="main" aria-label="Navigation principale">
        <a class={currentNav === 'accueil' ? 'on' : ''} href="/">Accueil</a>
        <a class={currentNav === 'actualites' ? 'on' : ''} href="/actualites/">Actualités</a>
        <a class={currentNav === 'evenements' ? 'on' : ''} href="/evenements/">Combats</a>
        <a class={currentNav === 'combattants' ? 'on' : ''} href="/combattants/">Combattants</a>
        <a class={currentNav === 'organisations' ? 'on' : ''} href="/organisations/">Organisations</a>
        <a class={currentNav === 'clubs' ? 'on' : ''} href="/clubs/">Clubs</a>
        <a class="nav-clubmma" href="https://clubmma.fr/" target="_blank" rel="noopener noreferrer" title="Boxing Center États-Unis — Salle MMA Toulouse">
          <span>Pôle MMA</span> <span class="tag-live">31</span>
        </a>
      </nav>

      <button class="burger" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="menu" data-menu>
        <i></i><i></i><i></i>
      </button>
    </div>
  </header>

  <!-- Mobile Drawer -->
  <div class="drawer" id="menu" data-drawer hidden>
    <button class="drawer__close" type="button" aria-label="Fermer le menu" data-close>&times;</button>
    <div class="drawer__brand">
      <span class="brand__mark">PRISE</span>
      <span class="brand__tag mono">MMA</span>
    </div>
    <nav aria-label="Rubriques mobiles">
      <a class={currentNav === 'accueil' ? 'on' : ''} href="/">Accueil</a>
      <a class={currentNav === 'actualites' ? 'on' : ''} href="/actualites/">Actualités</a>
      <a class={currentNav === 'evenements' ? 'on' : ''} href="/evenements/">Combats à venir</a>
      <a class={currentNav === 'combattants' ? 'on' : ''} href="/combattants/">Combattants</a>
      <a class={currentNav === 'organisations' ? 'on' : ''} href="/organisations/">Organisations</a>
      <a class={currentNav === 'clubs' ? 'on' : ''} href="/clubs/">Clubs & Salles</a>
      <a href="/a-propos/">À propos & Ligne éditoriale</a>
      <div class="drawer__featured-club">
        <span class="kicker">Partenaire entraînement</span>
        <a href="https://clubmma.fr/" target="_blank" rel="noopener noreferrer" class="drawer__club-link">
          <strong>Boxing Center États-Unis</strong>
          <span>MMA, lutte et grappling à Toulouse →</span>
        </a>
      </div>
    </nav>
  </div>

  <!-- ======================== TICKER UNIVERSEL ======================== -->
  <div class="ticker">
    <div class="ticker__dot"><b></b></div>
    <div class="ticker__rail">
      <div class="ticker__run">
        {latestArticles.map(article => <span class="tick"><strong>{formatDate(article.sourcePublishedAt, {month:'short', year:undefined})}</strong><span>{article.title}</span></span>)}
      </div>
    </div>
  </div>

  <noscript><nav class="no-script-nav" aria-label="Rubriques sans JavaScript"><a href="/actualites/">Actualités</a><a href="/evenements/">Combats</a><a href="/combattants/">Combattants</a><a href="/organisations/">Organisations</a><a href="/clubs/">Clubs</a></nav></noscript>
  <main id="contenu">
    <slot />
  </main>

  <!-- Cage wire divider Baffled Bar -->
  <div class="cage-wire" aria-hidden="true">
    <svg class="cage-wire__svg" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
      <polygon points="100,10 168,35 190,100 168,165 100,190 32,165 10,100 32,35" stroke="currentColor" stroke-width="0.5" opacity="0.15"></polygon>
      <polygon points="100,30 152,48 170,100 152,152 100,170 48,152 30,100 48,48" stroke="currentColor" stroke-width="0.3" opacity="0.08"></polygon>
    </svg>
  </div>

  <!-- ========================== SITE FOOTER ========================== -->
  <footer>
    <div class="footer-inner">
      <div class="footer-brand">
        <a class="brand" href="/" style="display: inline-flex; margin-bottom: 0.5rem;">
          <span class="brand__mark" style="font-size: 1.7rem;">PRISE</span>
          <span class="brand__tag mono" style="font-size: .85rem;">MMA</span>
        </a>
        <p>Média indépendant d'actualité MMA en français. Analyses de combats, calendrier complet, résultats en direct, portraits de combattants et cartographie des clubs français.</p>
        <div class="footer-affiliate-badge">
          <span class="kicker" style="color: var(--teal); margin-bottom: 0.3rem;">Club référence Sud-Ouest :</span>
          <a href="https://clubmma.fr/" target="_blank" rel="noopener noreferrer" class="link-clubmma">
            Boxing Center États-Unis — MMA à Toulouse ↗
          </a>
        </div>
      </div>

      <div class="footer-links">
        <h4>Rubriques</h4>
        <ul>
          <li><a href="/actualites/">Toutes les actualités</a></li>
          <li><a href="/evenements/">Calendrier des combats</a></li>
          <li><a href="/combattants/">Fiches combattants</a></li>
          <li><a href="/organisations/">Ligues & Organisations</a></li>
          <li><a href="/clubs/">Annuaire des clubs MMA</a></li>
        </ul>
      </div>

      <div class="footer-links">
        <h4>Organisations</h4>
        <ul>
          <li><a href="/organisations/ufc/">UFC (Ultimate Fighting Championship)</a></li>
          <li><a href="/organisations/ares/">ARES Fighting Championship</a></li>
          <li><a href="/organisations/hexagone-mma/">Hexagone MMA</a></li>
          <li><a href="/organisations/pfl/">PFL (Professional Fighters League)</a></li>
          <li><a href="/organisations/one-championship/">ONE Championship</a></li>
          <li><a href="/organisations/fmmaf/">FMMAF (Fédération Française)</a></li>
        </ul>
      </div>

      <div class="footer-links">
        <h4>Le média</h4>
        <ul>
          <li><a href="/a-propos/">À propos & Éthique</a></li>
          <li><a href="/a-propos/#contact">Proposer une actualité</a></li>
          <li><a href="/a-propos/#mentions">Mentions légales</a></li>
          <li><a href="https://clubmma.fr/" target="_blank" rel="noopener noreferrer">Club MMA Toulouse (Partenaire)</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="mono">© 2026 PRISE MMA — Média d'information indépendant. Les marques et logos des organisations appartiennent à leurs propriétaires respectifs.</p>
    </div>
  </footer>

  <a class="back-to-top" href="#contenu" aria-label="Retour en haut de page">↑</a>

  <script is:inline defer src="/assets/js/motion.js"></script>
</body>
</html>
